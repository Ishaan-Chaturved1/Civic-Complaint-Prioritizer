# ==========================================
# Civic Complaint Prioritizer - Environment Config
# ==========================================

# Application
APP_NAME=Civic Complaint Prioritizer
ENVIRONMENT=development
DEBUG=True
API_V1_PREFIX=/api

# Database (PostgreSQL URL, fallback to sqlite:///./civic_complaints.db if Postgres server is unavailable)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/civic_db
# SQLite fallback example:
# DATABASE_URL=sqlite:///./civic_complaints.db

# Authentication / Security
JWT_SECRET=super-secret-jwt-key-change-in-production-civic-ai-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Storage
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=15

# Dataset Paths (Root is local disk)
DATA_ROOT=D:/Major Project
POTHOLE_DATASET_PATH=D:/Major Project/potholes
GARBAGE_DATASET_PATH=D:/Major Project/garbage/IndiUrbanClean-Dataset-main

# Model Checkpoints & Directories
TEXT_MODEL_PATH=models/text/complaint_classifier
VISION_MODEL_PATH=models/vision/pothole_yolo.pt
GARBAGE_MODEL_PATH=models/vision/garbage_classifier.pt
SEGMENTATION_MODEL_PATH=models/vision/pothole_seg.pt
MULTIMODAL_MODEL_PATH=models/multimodal/priority_fusion.pt

# ML / Algorithm Thresholds
SIMILARITY_THRESHOLD=0.82
CONFIDENCE_THRESHOLD=0.35

# CORS (Frontend origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
